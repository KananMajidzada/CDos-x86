# Build artifacts
*.o
*.bin
*.iso
kernel/*.o
kernel/cdos-x86.bin
iso/boot/cdos-x86.bin
iso/boot/grub/grub.cfg.bak

# Cross-compiler toolchain (large, rebuildable from Phase 1 instructions)
toolchain/
build/

# Disk images (rebuildable via tools/build_disk.py)
disk/disk.img

# ROM binaries (redistributable per their license, but better fetched
# fresh from the authoritative source -- see README for the fetch commands)
roms/*.rom

# QEMU/debug artifacts
qemu_int_log*.txt
qemu_error.txt

# OS/editor cruft
.DS_Store
*.swp

# Cross-compiler source (large tarballs/trees, not part of the project itself)
src/

# Vendored third-party source (has its own .git -- fetch fresh, don't commit)
vendor/

# ISO staging directory (pure build output, regenerated by grub-mkrescue)
iso/boot/cdos-x86.bin
iso/boot/grub/grub.cfg

# ROM binaries copied into diskfiles/ for disk-image building -- fetch
# fresh per README instead of committing
diskfiles/*.ROM
*.bak
*.bak2
*.bak3
patch_*.py
